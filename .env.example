# Database Configuration
DATABASE_URL=postgresql://sms_user:sms_password@localhost:5432/sms_provider

# SMS Provider Mode: "smpp" or "textbelt"
SMS_PROVIDER=textbelt

# SMPP Carrier Configuration (only if SMS_PROVIDER=smpp)
SMPP_HOST=smpp.carrier.com
SMPP_PORT=2775
SMPP_SYSTEM_ID=your_system_id
SMPP_PASSWORD=your_password
SMPP_SYSTEM_TYPE=

# TextBelt Configuration (FREE SMS via email-to-SMS)
# Use any SMTP server - Gmail, Outlook, your own server, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info
MAX_RETRIES=3
QUEUE_MAX_SIZE=10000
KEEPALIVE_INTERVAL=30
MAX_RECONNECT_ATTEMPTS=10

# Performance
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
