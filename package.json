{
  "name": "sms-service-provider",
  "version": "0.1.0",
  "description": "Self-hosted SMS service provider with direct SMPP carrier integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx ts-node src/index.ts",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:init": "npx ts-node scripts/init-db.ts",
    "db:migrate": "npx ts-node scripts/migrate.ts",
    "cli": "npx ts-node src/cli.ts",
    "smpp:server": "npx ts-node src/smpp/testServer.ts"
  },
  "keywords": [
    "sms",
    "smpp",
    "messaging",
    "carrier",
    "telecommunications"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "nodemailer": "^8.0.3",
    "pg": "^8.11.3",
    "smpp": "^0.6.0-rc.4",
    "textbelt": "^0.0.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
